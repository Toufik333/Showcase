{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/notes/[id]",
      "regex": "^/api/notes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/notes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/shop/admin/orders/[id]",
      "regex": "^/api/shop/admin/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/shop/admin/orders/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/shop/admin/products/[id]",
      "regex": "^/api/shop/admin/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/shop/admin/products/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/tracker/transactions/[id]",
      "regex": "^/api/tracker/transactions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tracker/transactions/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/notes",
      "regex": "^/notes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/notes(?:/)?$"
    },
    {
      "page": "/shop",
      "regex": "^/shop(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop(?:/)?$"
    },
    {
      "page": "/shop/admin/dashboard",
      "regex": "^/shop/admin/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop/admin/dashboard(?:/)?$"
    },
    {
      "page": "/shop/admin/login",
      "regex": "^/shop/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop/admin/login(?:/)?$"
    },
    {
      "page": "/shop/checkout",
      "regex": "^/shop/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop/checkout(?:/)?$"
    },
    {
      "page": "/tracker",
      "regex": "^/tracker(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tracker(?:/)?$"
    },
    {
      "page": "/tracker/dashboard",
      "regex": "^/tracker/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tracker/dashboard(?:/)?$"
    },
    {
      "page": "/tracker/login",
      "regex": "^/tracker/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tracker/login(?:/)?$"
    },
    {
      "page": "/tracker/signup",
      "regex": "^/tracker/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tracker/signup(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}