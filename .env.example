# Database Configuration (MySQL / MariaDB)
# On Namecheap shared hosting, DB names and users are prefixed with your cPanel username:
#   DB_USER=cpaneluser_dbuser
#   DB_NAME=cpaneluser_money_tracker
# Create the database and user via cPanel → MySQL Databases Wizard
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
# DB_SSL=false is acceptable for localhost MySQL on Namecheap (same-server connection)
DB_SSL=false

# Authentication Secret — generate a strong random string (64+ characters)
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# E-Commerce Admin Default Password (used for admin1, admin2, admin3)
ADMIN_DEFAULT_PASSWORD=your_admin_default_password

# MongoDB Atlas Connection
# Get your connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=YourApp
MONGODB_DB=notes_app
