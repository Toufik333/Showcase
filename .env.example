# Database Configuration (MySQL / MariaDB)
# -------------------------------------------------------------
# Option 1 (Recommended for Aiven / TiDB / Cloud): Single Service URI
# Simply copy the Service URI from Aiven console and paste here:
# DATABASE_URL=mysql://avnadmin:your_password@your-service.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option 2: Individual variables (Local / cPanel / Shared Hosting):
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
# Set DB_SSL=true when using remote MySQL with individual variables
DB_SSL=false


# Authentication Secret — generate a strong random string (64+ characters)
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# E-Commerce Admin Default Password (used for admin1, admin2, admin3)
ADMIN_DEFAULT_PASSWORD=your_admin_default_password

# MongoDB Atlas Connection
# Get your connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=YourApp
MONGODB_DB=notes_app
